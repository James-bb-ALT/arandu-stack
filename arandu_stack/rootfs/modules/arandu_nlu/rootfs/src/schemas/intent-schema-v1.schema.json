{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/intent-schema-v1.schema.json",
  "title": "P09 intent schema source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "algorithm_id",
    "configuration_id",
    "source",
    "ranking",
    "intents"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema_id": {"const": "p09-intent-schema-v1"},
    "algorithm_id": {"type": "string"},
    "configuration_id": {"type": "string"},
    "source": {"type": "object"},
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score_maximum",
        "ambiguity_margin",
        "maximum_candidates",
        "maximum_slots_per_candidate"
      ],
      "properties": {
        "score_maximum": {"const": 10000},
        "ambiguity_margin": {"type": "integer", "minimum": 0, "maximum": 10000},
        "maximum_candidates": {"type": "integer", "minimum": 1, "maximum": 32},
        "maximum_slots_per_candidate": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_intent",
          "intent_id",
          "evidence_threshold",
          "markers",
          "slots"
        ]
      }
    }
  }
}
