{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlu.local/schemas/pos-evaluation-report-v1.schema.json",
  "title": "POS evaluation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "runner_id",
    "dataset_id",
    "dataset_version",
    "split",
    "claim_scope",
    "locale",
    "source_id",
    "source_manifest_sha256",
    "original_artifact_sha256",
    "manifest_sha256",
    "split_manifest_sha256",
    "heldout_sha256",
    "model_id",
    "model_package_sha256",
    "baseline_id",
    "selected_id",
    "metric_spec",
    "confusion_labels",
    "error_taxonomy",
    "limitations",
    "results",
    "baseline_delta"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "domain": {"const": "pos"},
    "runner_id": {"const": "pos-eval-v1"},
    "dataset_id": {"const": "p08-pos-internal-conformance"},
    "dataset_version": {"const": "1.0.0"},
    "split": {"const": "heldout"},
    "claim_scope": {"const": "internal_conformance_only"},
    "locale": {"const": "pt-BR"},
    "source_id": {"const": "project-authored-synthetic-ptbr-v1"},
    "source_manifest_sha256": {
      "const": "d9e1ca32ec0f92aa6b5fc6c1d4f232f93389e0bf8031267d23daddf7287006c5"
    },
    "original_artifact_sha256": {
      "const": "85ad18caf3ae749d3ec0135c3c01ce6d754f831d395abdc44ff1c3643a18fac8"
    },
    "manifest_sha256": {
      "const": "c4ca9531c45eaff9df8a79f48a060f7a1716c3102b37b4caa24a5cba708ff048"
    },
    "split_manifest_sha256": {
      "const": "bd6ef5cf79e188d43eb6b6ecddd4de7e5f767aab14316a3a4b677a04d9c2fb5c"
    },
    "heldout_sha256": {
      "const": "876e85049fb391b5171641e206b7bc2b4ae2bb4e1d58f36858bf1b5c91812dd7"
    },
    "model_id": {"const": "p08-pos-transition-model-v1"},
    "model_package_sha256": {
      "const": "23beb6dd464c4bd03d69bb374be210fd3a187661c37673194f466b4270b8020c"
    },
    "baseline_id": {
      "const": "lang-ptbr-independent-evidence-pos-baseline-v1"
    },
    "selected_id": {"const": "lang-ptbr-adjacent-transition-pos-v1"},
    "metric_spec": {"const": "exact-pos-candidate-set-aggregate-v1"},
    "confusion_labels": {"const": ["unknown", "unique", "ambiguous"]},
    "error_taxonomy": {
      "const": [
        "exact_set_mismatch",
        "missing_expected_candidate",
        "unexpected_candidate",
        "unexpected_unknown",
        "unresolved_ambiguity"
      ]
    },
    "limitations": {"$ref": "#/$defs/limitations"},
    "results": {"$ref": "#/$defs/results"},
    "baseline_delta": {"$ref": "#/$defs/baselineDelta"}
  },
  "$defs": {
    "limitations": {
      "const": [
        "project_authored_labels_share_generator_with_runtime_lexicon",
        "single_source_origin_not_origin_disjoint",
        "templatic_internal_conformance_not_independent_accuracy",
        "heldout_unknown_subset_contains_four_expected_x_tokens",
        "no_unseen_language_or_cross_origin_generalization_claim"
      ]
    },
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0}
      }
    },
    "candidateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["true_positive", "false_positive", "false_negative"],
      "properties": {
        "true_positive": {"type": "integer", "minimum": 0},
        "false_positive": {"type": "integer", "minimum": 0},
        "false_negative": {"type": "integer", "minimum": 0}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "correct", "unexpected"],
      "properties": {
        "expected": {"type": "integer", "minimum": 0},
        "correct": {"type": "integer", "minimum": 0},
        "unexpected": {"type": "integer", "minimum": 0}
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "compatible", "unresolved", "total"],
      "properties": {
        "exact": {"type": "integer", "minimum": 0},
        "compatible": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "confusionMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "matrix"],
      "properties": {
        "labels": {"const": ["unknown", "unique", "ambiguous"]},
        "matrix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "errorCategories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_set_mismatch",
        "missing_expected_candidate",
        "unexpected_candidate",
        "unexpected_unknown",
        "unresolved_ambiguity"
      ],
      "properties": {
        "exact_set_mismatch": {"type": "integer", "minimum": 0},
        "missing_expected_candidate": {
          "type": "integer",
          "minimum": 0
        },
        "unexpected_candidate": {"type": "integer", "minimum": 0},
        "unexpected_unknown": {"type": "integer", "minimum": 0},
        "unresolved_ambiguity": {"type": "integer", "minimum": 0}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "exact_token_sets",
        "candidate_counts",
        "sentence_exact",
        "document_exact",
        "origin_exact",
        "unknown",
        "ambiguity",
        "confusion_matrix",
        "error_categories"
      ],
      "properties": {
        "method_id": {
          "enum": [
            "lang-ptbr-independent-evidence-pos-baseline-v1",
            "lang-ptbr-adjacent-transition-pos-v1"
          ]
        },
        "exact_token_sets": {"$ref": "#/$defs/fraction"},
        "candidate_counts": {"$ref": "#/$defs/candidateCounts"},
        "sentence_exact": {"$ref": "#/$defs/fraction"},
        "document_exact": {"$ref": "#/$defs/fraction"},
        "origin_exact": {"$ref": "#/$defs/fraction"},
        "unknown": {"$ref": "#/$defs/unknown"},
        "ambiguity": {"$ref": "#/$defs/ambiguity"},
        "confusion_matrix": {"$ref": "#/$defs/confusionMatrix"},
        "error_categories": {"$ref": "#/$defs/errorCategories"}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "selected"],
      "properties": {
        "baseline": {
          "allOf": [
            {"$ref": "#/$defs/method"},
            {
              "const": {
                "ambiguity": {
                  "compatible": 2,
                  "exact": 0,
                  "total": 2,
                  "unresolved": 2
                },
                "candidate_counts": {
                  "false_negative": 80,
                  "false_positive": 2,
                  "true_positive": 559
                },
                "confusion_matrix": {
                  "labels": ["unknown", "unique", "ambiguous"],
                  "matrix": [[4, 0, 0], [80, 557, 2], [0, 0, 0]]
                },
                "document_exact": {"denominator": 9, "numerator": 0},
                "error_categories": {
                  "exact_set_mismatch": 82,
                  "missing_expected_candidate": 80,
                  "unexpected_candidate": 2,
                  "unexpected_unknown": 80,
                  "unresolved_ambiguity": 2
                },
                "exact_token_sets": {
                  "denominator": 643,
                  "numerator": 561
                },
                "method_id": "lang-ptbr-independent-evidence-pos-baseline-v1",
                "origin_exact": {"denominator": 1, "numerator": 0},
                "sentence_exact": {"denominator": 81, "numerator": 0},
                "unknown": {"correct": 4, "expected": 4, "unexpected": 80}
              }
            }
          ]
        },
        "selected": {
          "allOf": [
            {"$ref": "#/$defs/method"},
            {
              "const": {
                "ambiguity": {
                  "compatible": 2,
                  "exact": 1,
                  "total": 2,
                  "unresolved": 1
                },
                "candidate_counts": {
                  "false_negative": 80,
                  "false_positive": 1,
                  "true_positive": 559
                },
                "confusion_matrix": {
                  "labels": ["unknown", "unique", "ambiguous"],
                  "matrix": [[4, 0, 0], [80, 558, 1], [0, 0, 0]]
                },
                "document_exact": {"denominator": 9, "numerator": 0},
                "error_categories": {
                  "exact_set_mismatch": 81,
                  "missing_expected_candidate": 80,
                  "unexpected_candidate": 1,
                  "unexpected_unknown": 80,
                  "unresolved_ambiguity": 1
                },
                "exact_token_sets": {
                  "denominator": 643,
                  "numerator": 562
                },
                "method_id": "lang-ptbr-adjacent-transition-pos-v1",
                "origin_exact": {"denominator": 1, "numerator": 0},
                "sentence_exact": {"denominator": 81, "numerator": 0},
                "unknown": {"correct": 4, "expected": 4, "unexpected": 80}
              }
            }
          ]
        }
      }
    },
    "baselineDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "exact_token_sets",
        "candidate_true_positive",
        "candidate_false_positive",
        "candidate_false_negative",
        "sentence_exact",
        "document_exact",
        "origin_exact",
        "unknown_correct",
        "unexpected_unknown",
        "ambiguity_exact",
        "ambiguity_compatible",
        "ambiguity_unresolved"
      ],
      "properties": {
        "direction": {"const": "selected_minus_baseline"},
        "exact_token_sets": {"const": 1},
        "candidate_true_positive": {"const": 0},
        "candidate_false_positive": {"const": -1},
        "candidate_false_negative": {"const": 0},
        "sentence_exact": {"const": 0},
        "document_exact": {"const": 0},
        "origin_exact": {"const": 0},
        "unknown_correct": {"const": 0},
        "unexpected_unknown": {"const": 0},
        "ambiguity_exact": {"const": 1},
        "ambiguity_compatible": {"const": 0},
        "ambiguity_unresolved": {"const": -1}
      }
    }
  }
}
