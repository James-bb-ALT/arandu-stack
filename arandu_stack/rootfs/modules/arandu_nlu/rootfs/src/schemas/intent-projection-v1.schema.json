{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/intent-projection-v1.schema.json",
  "title": "P09 pre-resolution oracle projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "schema_id",
    "source",
    "span_derivation",
    "intent_projections"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "projection_id": {"const": "p09-pre-resolution-oracle-projection-v1"},
    "schema_id": {"const": "p09-intent-schema-v1"},
    "source": {"type": "object"},
    "span_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "require_unique_match",
        "source_output_allowed",
        "normalization_allowed"
      ],
      "properties": {
        "algorithm": {"const": "p02-generator-parameter-exact-utf8-substring-v1"},
        "require_unique_match": {"const": true},
        "source_output_allowed": {"const": false},
        "normalization_allowed": {"const": false}
      }
    },
    "intent_projections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["external_intent", "intent_id", "slots"]
      }
    }
  }
}
