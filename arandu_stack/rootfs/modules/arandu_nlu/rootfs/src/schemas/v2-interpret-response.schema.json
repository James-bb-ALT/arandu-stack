{
  "$id": "urn:arandu-nlu:v2-interpret:response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned full-interpretation response",
  "description": "Wire-shape projection of local_nlu::InterpretResponseV2 (internally tagged on status, version 2). Operations mirror the v1 Operation shape. Ambiguous and no_match publish no operations. Transport errors use the invalid_request envelope, never this schema.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version", "operations"],
      "properties": {
        "status": {"const": "plan"},
        "version": {"const": 2},
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "targets"],
            "properties": {
              "action": {
                "type": "string",
                "enum": ["get_state", "set_fan_percentage", "turn_off", "turn_on"]
              },
              "percentage": {"type": "integer", "minimum": 0, "maximum": 100},
              "targets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {"type": "string"}
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version"],
      "properties": {
        "status": {"const": "ambiguous"},
        "version": {"const": 2}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version"],
      "properties": {
        "status": {"const": "no_match"},
        "version": {"const": 2}
      }
    }
  ]
}
