{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlu.local/schemas/data-stage-manifest-v1.schema.json",
  "title": "NLU data stage manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "transform_id",
    "source_manifest_sha256",
    "input_records_sha256",
    "records_sha256",
    "record_count",
    "source_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"enum": ["imported", "normalized", "split", "filtered"]},
    "transform_id": {"type": "string", "minLength": 1},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_records_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 0},
    "source_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
