{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlu.local/schemas/lexicon-entry-v1.schema.json",
  "title": "NLU lexicon entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "surface",
    "lemma",
    "pos",
    "features",
    "source",
    "generation",
    "transformations",
    "derivative_license"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_id": {"$ref": "#/$defs/identifier"},
    "surface": {"$ref": "#/$defs/text"},
    "lemma": {"$ref": "#/$defs/text"},
    "pos": {
      "enum": ["ADJ", "ADP", "ADV", "CCONJ", "DET", "NOUN", "VERB"]
    },
    "features": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/text"},
          {"type": "string", "pattern": "="}
        ]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "admission_status",
        "corpus_version",
        "locale",
        "source_license",
        "partition",
        "source_manifest_sha256",
        "artifact_path",
        "artifact_sha256",
        "record_id",
        "record_sha256"
      ],
      "properties": {
        "source_id": {"const": "project-authored-synthetic-ptbr-v1"},
        "admission_status": {"const": "PROJECT_AUTHORED_SYNTHETIC"},
        "corpus_version": {"const": "1.0.0"},
        "locale": {"const": "pt-BR"},
        "source_license": {"const": "Apache-2.0"},
        "partition": {"const": "shared"},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_path": {
          "const": "data/project-authored/p02-v1/lexicon.jsonl"
        },
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "record_id": {"$ref": "#/$defs/identifier"},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_id",
        "generator_implementation_sha256",
        "specification_path",
        "specification_sha256",
        "family",
        "parameters",
        "canonical_identity_sha256"
      ],
      "properties": {
        "generator_id": {"const": "p02-generator-v1"},
        "generator_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "specification_path": {
          "const": "data/project-authored/p02-v1/specification.yaml"
        },
        "specification_sha256": {"$ref": "#/$defs/sha256"},
        "family": {"const": "p02-generator-v1/build_lexicon_records"},
        "parameters": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "values"],
            "properties": {
              "name": {"enum": ["surface", "lemma", "pos", "features"]},
              "values": {
                "type": "array",
                "items": {"type": "string", "maxLength": 65536}
              }
            }
          }
        },
        "canonical_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "transformations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transform_id",
          "implementation_sha256",
          "input_sha256",
          "output_sha256"
        ],
        "properties": {
          "transform_id": {
            "enum": ["p02-generator-v1", "ptbr-lexicon-compile-v1"]
          },
          "implementation_sha256": {"$ref": "#/$defs/sha256"},
          "input_sha256": {"$ref": "#/$defs/sha256"},
          "output_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "derivative_license": {"const": "Apache-2.0"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
