{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlu.local/schemas/lexicon-package-manifest-v1.schema.json",
  "title": "NLU lexicon package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "transform_id",
    "input_sha256",
    "package_sha256",
    "package_bytes",
    "entry_count",
    "source_ids",
    "derivative_licenses"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "format": {"const": "nlu-lexicon-package-v1"},
    "transform_id": {
      "enum": ["ptbr-lexicon-compile-v1", "ptbr-lexicon-source-filter-v1"]
    },
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_bytes": {
      "type": "integer",
      "minimum": 16,
      "maximum": 33554432
    },
    "entry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000
    },
    "source_ids": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"const": "project-authored-synthetic-ptbr-v1"}
    },
    "derivative_licenses": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"const": "Apache-2.0"}
    }
  }
}
